  type: article
  title: 'RingdateR: A Statistical and Graphical Tool for Crossdating'
  authors:
    - given-names: David J.
      family-names: Reynolds
    - given-names: David C.
      family-names: Edge
    - given-names: Bryan A.
      family-names: Black
  journal: Dendrochronologia
